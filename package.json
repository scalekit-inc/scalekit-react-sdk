{
  "name": "@scalekit-sdk/react",
  "version": "0.1.0",
  "description": "React SDK for Scalekit OIDC authentication",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && rollup -c rollup.dts.config.js",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "oidc-client-ts": "^3.5.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.2.18",
    "@typescript/typescript6": "^6.0.2",
    "happy-dom": "^21.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.68.8",
    "rollup-plugin-dts": "^6.5.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "scalekit",
    "oidc",
    "oauth",
    "authentication",
    "react",
    "sso",
    "pkce"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "Scalekit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scalekit/scalekit-react-sdk"
  }
}
